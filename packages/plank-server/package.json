{
  "name": "@plank/server",
  "version": "1.0.0",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "build": "tsc && tsc-alias",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.11.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@plank/eslint": "workspace:*",
    "@plank/tsconfig": "workspace:*",
    "@types/node": "^26.1.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.4",
    "tsc-alias": "^1.9.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "dependencies": {
    "@plank/db": "workspace:*",
    "@fastify/swagger": "^9.8.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@scalar/fastify-api-reference": "^1.62.5",
    "awilix": "^13.0.5",
    "fastify": "^5.10.0",
    "rxjs": "^7.8.2",
    "typebox": "^1.3.6"
  }
}
