{
  "name": "@plank/web",
  "version": "1.0.0",
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.11.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch --env-file=.env bin/dev.ts",
    "build:server": "cross-env NODE_ENV=production esbuild bin/start.ts --bundle --platform=node --format=esm --outfile=dist/server/start.js --packages=external",
    "build": "cross-env NODE_ENV=production react-router build && pnpm build:server",
    "start": "cross-env NODE_ENV=production node dist/server/start.js"
  },
  "type": "module",
  "dependencies": {
    "@plank/client": "workspace:*",
    "@plank/common": "workspace:*",
    "@plank/server": "workspace:*",
    "@react-router/express": "^8.2.0",
    "@react-router/node": "^8.2.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-table": "^8.21.3",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "isbot": "^5.2.0",
    "lucide": "^1.25.0",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "nuqs": "^2.9.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "qs": "^6.15.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-router": "^8.2.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.2.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.1",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.0",
    "vite": "^8.1.4",
    "vite-plugin-devtools-json": "^1.0.0"
  }
}
